                <div class="py-tklp-preview-meta">
                    <div><strong><?= $block->escapeHtml(__('Current source')) ?>:</strong> <?= $block->escapeHtml($isManaged ? __('Local asset') : ($currentValue ? __('External URL') : __('Empty'))) ?></div>
