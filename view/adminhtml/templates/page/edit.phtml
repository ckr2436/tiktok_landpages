    $isManaged = $block->isManagedImage($currentValue);
    ?>
    <div class="py-tklp-media-field" data-media-field>
        <input type="hidden" name="<?= $block->escapeHtmlAttr($valueField) ?>_existing" value="<?= $block->escapeHtmlAttr((string)$currentValue) ?>" />
        <div class="py-tklp-media-grid">
            <div class="py-tklp-media-main">
                <label class="admin__field-label py-tklp-label"><?= $block->escapeHtml(__('External URL')) ?></label>
                <input
                    class="admin__control-text"
                    type="url"
                    name="<?= $block->escapeHtmlAttr($valueField) ?>"
                    value="<?= $block->escapeHtmlAttr($externalValue) ?>"
                    placeholder="https://example.com/your-image.jpg"
                />
                <p class="note"><span><?= $block->escapeHtml(__('Keep this empty if you want to use a locally uploaded image.')) ?></span></p>

                <label class="admin__field-label py-tklp-label" style="margin-top:16px;"><?= $block->escapeHtml(__('Upload from computer')) ?></label>
                <div class="py-tklp-dropzone" data-dropzone>
                    <input
                        type="file"
                        name="<?= $block->escapeHtmlAttr($fileField) ?>"
                        accept=".jpg,.jpeg,.png,.webp,.gif"
                        class="py-tklp-file-input"
                        data-file-input
                    />
