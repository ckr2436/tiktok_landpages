                    <div class="py-tklp-dropzone-sub"><?= $block->escapeHtml(__('or click to choose a file from your computer')) ?></div>
                    <div class="py-tklp-file-meta" data-file-meta><?= $block->escapeHtml(__('No file selected')) ?></div>
                </div>
                <p class="note">
                    <span><?= $block->escapeHtml(__('Allowed: %1. Max size: %2 MB. Uploaded files are stored in pub/media/%3 and are only uploaded through this admin page when you save.', $block->getAllowedImageExtensionsLabel(), (string)$block->getMaxUploadSizeMb(), $block->getManagedMediaBasePath())) ?></span>
                </p>

                <div style="margin-top:12px;">
                    <label class="admin__field-label" style="display:flex;align-items:center;gap:8px;">
                        <input type="checkbox" name="<?= $block->escapeHtmlAttr($valueField) ?>_delete" value="1" />
                        <span><?= $block->escapeHtml(__('Remove current image')) ?></span>
                    </label>
                </div>

                <?php if ($hint !== ''): ?>
                    <p class="note"><span><?= $block->escapeHtml($hint) ?></span></p>
                <?php endif; ?>
            </div>

            <div class="py-tklp-media-preview">
                <div class="py-tklp-preview-box">
                    <?php if ($previewUrl): ?>
                        <img src="<?= $block->escapeUrl($previewUrl) ?>" alt="<?= $block->escapeHtmlAttr($label) ?>" />
                    <?php else: ?>
                        <div class="py-tklp-preview-empty"><?= $block->escapeHtml(__('No image')) ?></div>
                    <?php endif; ?>
